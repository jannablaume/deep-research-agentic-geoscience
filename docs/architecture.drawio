<mxfile host="app.diagrams.net" modified="2026-09-14T00:00:00.000Z" agent="claude-code" version="24.7.17" type="device">
  <diagram id="dr-agentic-geoscience-arch" name="Architecture">
    <mxGraphModel dx="1700" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bgLaneA" value="SCRIPTS — deterministic. Every number in the review is produced here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#9fb8d8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#39618f;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="1410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bgLaneB" value="THE AGENT — executing the versioned prompt from prompts/. Judgment. Nothing is counted here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9f2;strokeColor=#e5bd85;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#a06a00;" vertex="1" parent="1">
          <mxGeometry x="250" y="290" width="1410" height="125" as="geometry" />
        </mxCell>

        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;deep-research-agentic-geoscience&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444444;&quot;&gt;A scoping-review pipeline: the deterministic work is a script, the judgment is an agent running a versioned prompt, and neither half pretends to be the other.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="inp" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Inputs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;reference/&lt;/b&gt;&lt;br&gt;the query plan and the output contract&lt;br&gt;&lt;br&gt;&lt;b&gt;prompts/&lt;/b&gt;&lt;br&gt;the judgment half, versioned — and a slash command by symlink" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="170" height="255" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Harvest&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;make harvest&lt;/i&gt;&lt;br&gt;&lt;br&gt;Search OpenAlex and arXiv, page, and merge preprint with published version." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="182" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Triage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;make triage&lt;/i&gt;&lt;br&gt;&lt;br&gt;Rank the corpus into a shortlist, plus a sample from below the cut." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="182" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="human" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;The person running it&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Invokes the prompt as a slash command, and at 02's one deliberate pause hands back the sources behind a paywall — institutional access is the only thing the session cannot get for itself." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0a08c;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="322" width="420" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Screen and deep-read&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decide what is in scope, read the core set, and extract it into the comparison grid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="322" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Write the report&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Descriptive only. Every claim carries its evidential status and points at a source." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="975" y="322" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Audit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;make audit&lt;/i&gt;&lt;br&gt;&lt;br&gt;Check the finished run against its contract, on disk. Exits non-zero." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="182" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;Export and build&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;make export · make web&lt;/i&gt;&lt;br&gt;&lt;br&gt;One run becomes one JSON document, and the dashboard reads nothing else." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1445" y="182" width="210" height="86" as="geometry" />
        </mxCell>

        <mxCell id="o1" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;outputs/&amp;lt;run&amp;gt;/&amp;lt;version&amp;gt;/&lt;/font&gt;&lt;/b&gt; — the run record&lt;br&gt;The corpus, your screening decisions, the comparison grid with its verbatim extracts, the report, the audit table, and RUN.md.&amp;nbsp; &lt;b&gt;A committed run is evidence&lt;/b&gt;: it is superseded by a new version, never edited." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="470" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;web/dist/&lt;/font&gt;&lt;/b&gt; — one dashboard per run&lt;br&gt;A static folder that opens from the filesystem, so it can be handed to somebody as it is." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="470" width="655" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#4d7db5;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#4d7db5;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#c08000;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#4d7db5;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#4d7db5;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ei1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" parent="1" source="inp" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ei2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=1.5;" edge="1" parent="1" source="inp" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eo1" value="every stage writes here" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#666666;" edge="1" parent="1" source="s3" target="o1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eo2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s6" target="o2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="runsLabel" value="&lt;b&gt;THREE RUNS — the same pipeline, three questions&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;01_landscape&lt;/b&gt;&lt;br&gt;What has been built in agentic AI for solid-earth and subsurface geoscience." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="525" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;02_tango&lt;/b&gt;&lt;br&gt;What exists that bears on making TANGO agentic — agents that drive a simulator or solver." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="587" y="620" width="525" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;03_gaps&lt;/b&gt;&lt;br&gt;What the two finished runs already record as missing. Harvests nothing — its corpus is their artifacts." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1135" y="620" width="525" height="70" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="&lt;b&gt;Reproducible three years from now because:&lt;/b&gt; the prompt and the output it produced are committed together · &lt;b&gt;RUN.md&lt;/b&gt; records the prompt commit, the model, the thresholds and the counts · &lt;b&gt;decisions.md&lt;/b&gt; records why each choice was made and what it rules out · &lt;b&gt;docs/architecture.md&lt;/b&gt; and &lt;b&gt;AGENTS.md&lt;/b&gt; carry the rationale and the full instructions.&lt;br&gt;&lt;br&gt;&lt;b&gt;The one rule:&lt;/b&gt; a number is counted or it is not stated. Where a count cannot be computed the artifact says so, and the dashboard renders an em dash rather than a zero." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="1620" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
