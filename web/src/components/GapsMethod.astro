---
/**
 * How this synthesis was assembled — the 03 version of `Method.astro`.
 *
 * Shorter than the other two: 03 harvests nothing, so there is no query plan
 * and no derived framework facet to disclose. What is here instead is which
 * two runs, at what commit, this gaps document is a statement about — the
 * fact that makes every evidence key on the page resolvable at all.
 */
import type { GapsDataset } from '../lib/types';

interface Props {
  data: GapsDataset;
}
const { data } = Astro.props;

const run = data.run;
const failed = data.audit.checks.filter((c) => c.result !== 'PASS');
---

<div class="section-head">
  <h2>How this was assembled</h2>
  <p>
    Synthesis only: this run reads the two finished runs below, extracts every gap
    candidate mechanically, and sends a verification pass after each one before it is
    stated. It states no opinion about which gap matters most or what to do about any of
    them.
  </p>
</div>

<div class="two-up">
  <div class="panel">
    <div class="head">
      <h3>Run record</h3>
      <span class="muted">{run.version}</span>
    </div>
    <div class="body">
      <dl class="kv">
        <dt>run directory</dt>
        <dd>
          <code>{run.path}</code>
        </dd>
        <dt>prompt</dt>
        <dd>{run.prompt || <span class="na">not stated</span>}</dd>
        <dt>model</dt>
        <dd>{run.model || <span class="na">not stated</span>}</dd>
        <dt>date</dt>
        <dd>{run.date || <span class="na">not stated</span>}</dd>
      </dl>
      <h4 class="eyebrow" style="margin:1.25rem 0 .6rem">Which runs were read</h4>
      <div class="scroll-x">
        <table class="grid">
          <thead>
            <tr>
              <th>Run</th>
              <th>Directory</th>
              <th>Commit</th>
            </tr>
          </thead>
          <tbody>
            {
              run.source_runs.map((r) => (
                <tr>
                  <td>{r.name}</td>
                  <td>
                    <code>{r.directory}</code>
                  </td>
                  <td>
                    <code>{r.commit}</code>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {
        data.unaccounted.length > 0 && (
          <p class="muted" style="margin-top:1rem;color:var(--absent)">
            {data.unaccounted.length} candidates are neither cited by a gap nor in the
            discard ledger: {data.unaccounted.join(', ')}.
          </p>
        )
      }
    </div>
  </div>

  <div class="panel">
    <div class="head">
      <h3>Contract audit</h3>
      <span class={failed.length === 0 ? 'pass' : 'fail'}>
        {data.audit.passed}/{data.audit.checks.length} pass
      </span>
    </div>
    <div class="body">
      <p class="muted" style="margin:0 0 1rem">
        Generated by <code>scripts/audit_gaps.py</code>, which parses this run's own
        artifacts and exits non-zero on failure.
      </p>
      <div class="scroll-x">
        <table class="grid">
          <thead>
            <tr>
              <th>Check</th>
              <th>Result</th>
              <th>Detail</th>
            </tr>
          </thead>
          <tbody>
            {
              data.audit.checks.map((c) => (
                <tr>
                  <td>{c.check}</td>
                  <td class={c.result === 'PASS' ? 'pass' : 'fail'}>{c.result}</td>
                  <td style="color:var(--muted)">{c.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
