# Copy to .env and fill in. `.env` is gitignored; nothing here is read
# automatically — `make harvest` sources it, and a bare `python3 scripts/harvest.py`
# reads these from the shell.

# Free, from https://openalex.org — and effectively required for a full harvest.
# OpenAlex meters the API against a daily USD budget: $0.10/day keyless, $1/day
# with a key. A full harvest is ~300 search calls, so keyless it dies partway
# through with HTTP 429 "Insufficient budget" and leaves a corpus that looks
# complete. harvest.py aborts rather than retrying, but the run is still short.
OPENALEX_API_KEY=

# Optional. OpenAlex serves a faster "polite pool" to callers who identify
# themselves. Left out of the repository so no address is baked into it.
OPENALEX_MAILTO=

# Optional. Without it Semantic Scholar returns 429 on nearly every call, which is
# why `--no-s2` is the documented default. With it, S2 becomes a usable third index.
S2_API_KEY=
