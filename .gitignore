.DS_Store
*.pdf
*.zip

# Secrets and local settings. Nothing here is ever committed.
.env
.claude/settings.local.json
settings.local.json

# Internal and non-redistributable inputs. The remote is public, so these are ignored
# by name as well as by extension — `*.pdf` above already covers the article files, but
# the TANGO note is Markdown and nothing else would stop `git add -A` sweeping it in.
#
# `tango_complete_reference.md` is the 02 run's description of TANGO and carries GEG's
# product tiers, the open/closed component boundary and named colleagues. The 02 prompt
# treats it as a hard local dependency and stops if it is absent, which is the honest
# behaviour for anyone else cloning this: they cannot reproduce that run, and the
# alternative is publishing an unpublished commercial roadmap.
#
# The unreachable-paper folders hold publisher PDFs retrieved by hand, one per run. They
# are evidence for a run and they are not ours to redistribute.
tango_complete_reference.md
01_unreachable_paper/
02_unreachable_paper/
paywalled_paper*/
previous_paywalled_paper.md

# Environments and tool caches
.venv/
__pycache__/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Regenerable harvest artifacts: 22MB each, rebuilt from reference/queries.json in
# minutes. The irreplaceable outputs (screening.csv, papers.csv, papers.md) stay tracked.
outputs/**/screened.csv
outputs/**/triage.csv

# Scratch from delegated deep-read batches (fetched HTML, helper scripts, partial CSVs).
outputs/**/.deepread/

# The web front end's build inputs and outputs. `landscape.web.json` is written by
# scripts/export_web.py from a committed run, so it regenerates in seconds.
web/node_modules/
web/dist/
web/src/data/
